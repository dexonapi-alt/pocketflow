{
  "name": "plannerflow",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:migrate": "pnpm --filter @plannerflow/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @plannerflow/api exec prisma generate",
    "db:studio": "pnpm --filter @plannerflow/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
