// ─────────────────────────────────────────────
// PlannerFlow — Prisma Schema
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────

enum SalaryFrequency {
  MONTHLY
  BIWEEKLY
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVE
  ADJUSTMENT
}

enum TransactionStatus {
  POSTED
  PENDING
}

enum TransactionSource {
  MANUAL
  SYSTEM
  AI
  IMPORT
}

enum CategoryType {
  INCOME
  EXPENSE
  SAVE
}

enum BudgetPeriodType {
  MONTHLY
  PAY_CYCLE
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum InsightType {
  WEEKLY_SUMMARY
  SPENDING_ALERT
  SAVINGS_TIP
  FORECAST
}

enum InsightSeverity {
  INFO
  WARNING
  SUCCESS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SubscriptionPlan {
  FREE
  LITE
  PLUS
  PRO_PLUS
}

// ─── Models ──────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  currency     String   @default("PHP")
  timezone     String   @default("Asia/Manila")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  onboardingProfile OnboardingProfile?
  categories        Category[]
  transactions      Transaction[]
  payCycles         PayCycle[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  fixedExpenses     FixedExpense[]
  purchaseGoals     PurchaseGoal[]
  aiConversations   AiConversation[]
  aiInsights        AiInsight[]
  notifications     Notification[]
  plannerEvents     PlannerEvent[]
  userTasks         UserTask[]
  subscription      Subscription?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OnboardingProfile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  salaryAmount         Decimal         @db.Decimal(12, 2)
  salaryFrequency      SalaryFrequency
  paydayDayOfMonth     Int?
  nextPayday           DateTime?
  startingBalance      Decimal?        @db.Decimal(12, 2)
  defaultSavingsTarget Decimal?        @db.Decimal(12, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

model Category {
  id       String       @id @default(cuid())
  userId   String?
  name     String
  type     CategoryType
  icon     String?
  color    String?
  isSystem Boolean      @default(false)
  createdAt DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgetItems  BudgetItem[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  categoryId      String?
  type            TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  note            String?
  merchantName    String?
  transactionDate DateTime
  status          TransactionStatus @default(POSTED)
  source          TransactionSource @default(MANUAL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  savingsLinks SavingsAllocation[]

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([categoryId])
  @@map("transactions")
}

model PayCycle {
  id             String   @id @default(cuid())
  userId         String
  startDate      DateTime
  endDate        DateTime
  expectedIncome Decimal? @db.Decimal(12, 2)
  actualIncome   Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate, endDate])
  @@map("pay_cycles")
}

model Budget {
  id         String           @id @default(cuid())
  userId     String
  name       String
  periodType BudgetPeriodType
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@index([userId, startDate, endDate])
  @@map("budgets")
}

model BudgetItem {
  id          String  @id @default(cuid())
  budgetId    String
  categoryId  String
  limitAmount Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@map("budget_items")
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations SavingsAllocation[]

  @@index([userId, isArchived])
  @@map("savings_goals")
}

model SavingsAllocation {
  id            String   @id @default(cuid())
  transactionId String
  savingsGoalId String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([savingsGoalId])
  @@map("savings_allocations")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  model          String?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiInsight {
  id           String          @id @default(cuid())
  userId       String
  insightType  InsightType
  title        String
  body         String
  severity     InsightSeverity @default(INFO)
  metadataJson Json?
  generatedAt  DateTime        @default(now())
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, insightType])
  @@index([generatedAt])
  @@map("ai_insights")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Planner / Calendar ─────────────────────

model PlannerEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        DateTime
  color       String?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("planner_events")
}

// ─── Task Manager ───────────────────────────

model UserTask {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("user_tasks")
}

// ─── Fixed Expenses ─────────────────────────

model FixedExpense {
  id        String          @id @default(cuid())
  userId    String
  name      String
  amount    Decimal         @db.Decimal(12, 2)
  frequency SalaryFrequency @default(MONTHLY)
  dueDate   Int?
  icon      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fixed_expenses")
}

// ─── Purchase Goals ─────────────────────────

model PurchaseGoal {
  id          String    @id @default(cuid())
  userId      String
  name        String
  targetPrice Decimal   @db.Decimal(12, 2)
  icon        String?
  notes       String?
  isAchieved  Boolean   @default(false)
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("purchase_goals")
}

// ─── Subscriptions ──────────────────────────

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  plan      SubscriptionPlan @default(FREE)
  startsAt  DateTime         @default(now())
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
